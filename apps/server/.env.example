# Server
PORT=3001
# Relative to apps/server, or absolute. Default: ./data/domino.db
# DATABASE_URL=./data/domino.db
# Origin allowed for CORS (vite dev server)
# WEB_ORIGIN=http://localhost:5173

# AI DM provider: deepseek (default) | groq | ollama | openrouter
# DM_PROVIDER=deepseek
# DM_MODEL=deepseek-v4-flash

# --- DeepSeek (paid, very cheap; model deepseek-v4-flash) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Groq (free tier, rate-limited; llama-3.3-70b-versatile) ---
# Key: https://console.groq.com/keys
# GROQ_API_KEY=

# --- Ollama (100% free, local; model qwen3:8b; run `ollama pull qwen3:8b`) ---
# DM_PROVIDER=ollama
# DM_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OpenRouter (free :free models available, rate-limited) ---
# Key: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# DM_MODEL=deepseek/deepseek-v4-flash:free

# --- AI obrazki (opcjonalne) ---
# IMAGE_PROVIDER=pollinations  # pollinations (bez klucza) | gemini (klucz ponizej) | off
# GEMINI_API_KEY=
